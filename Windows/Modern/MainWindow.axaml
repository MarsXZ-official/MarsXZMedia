<Window Icon="/Assets/Icons/MarsXZMedia.png" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MarsXZMedia.MainWindow"
        Title="MarsXZ Media" 
        MinWidth="620" 
        MinHeight="500" 
        SizeToContent="Height"
        Width="620"
        Background="{DynamicResource AppWindowBackground}">

    <Window.Styles>
        <Style Selector="Button.mc-btn">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource AppActionButtonForeground}"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.mc-btn.mc-btn-gray">
            <Setter Property="Background" Value="{DynamicResource AppActionButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppActionButtonBorder}"/>
        </Style>
        <Style Selector="Button.mc-btn.mc-btn-green">
            <Setter Property="Background" Value="#3C8527"/>
            <Setter Property="BorderBrush" Value="#1E4613"/>
        </Style>
        <Style Selector="Button.mc-btn.mc-btn-wood">
            <Setter Property="Background" Value="#A1744B"/>
            <Setter Property="BorderBrush" Value="#3D2B1F"/>
        </Style>
        <Style Selector="Button.mc-btn.mc-btn-stone">
            <Setter Property="Background" Value="{DynamicResource AppActionButtonBackground}"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
        </Style>

        <Style Selector="Button.mc-btn.mc-btn-youtube">
            <Setter Property="Background" Value="#E60000"/>
            <Setter Property="BorderBrush" Value="#800000"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.mc-btn.mc-btn-gray:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppActionButtonHover}"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.mc-btn.mc-btn-green:pointerover">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="BorderBrush" Value="#2F6E1C"/>
        </Style>

        <Style Selector="Button.mc-btn.mc-btn-green:pressed">
            <Setter Property="Background" Value="#2F6E1C"/>
            <Setter Property="BorderBrush" Value="#16350E"/>
            <Setter Property="RenderTransform">
                <TranslateTransform Y="2"/>
            </Setter>
        </Style>
        <Style Selector="Button.mc-btn.mc-btn-wood:pointerover">
            <Setter Property="Background" Value="#B8865A"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.mc-btn.mc-btn-stone:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppActionButtonHover}"/>
            <Setter Property="BorderBrush" Value="#A8A8A8"/>
        </Style>

        <Style Selector="Button.mc-btn.mc-btn-youtube:pointerover">
            <Setter Property="Background" Value="#CC0000"/>
            <Setter Property="BorderBrush" Value="#700000"/>
        </Style>
        <Style Selector="Button.mc-btn.mc-btn-youtube:pressed">
            <Setter Property="Background" Value="#A80000"/>
            <Setter Property="BorderBrush" Value="#5C0000"/>
        </Style>
        <Style Selector="Button.mc-btn.mc-btn-youtube:disabled">
            <Setter Property="Background" Value="#808080"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Foreground" Value="#D0D0D0"/>
        </Style>
    </Window.Styles>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="ГЛАВНАЯ" Click="OpenMain_Click"/>
            <MenuItem Header="ИСТОРИЯ" Click="OpenHistory_Click"/>
            <MenuItem Header="НАСТРОЙКИ" Click="OpenSettings_Click"/>
        </Menu>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid TextElement.FontSize="18" Margin="0,0,0,20">
                <ContentControl x:Name="MainContent">
                    <StackPanel Margin="15" Spacing="10">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBox x:Name="UrlBox" Watermark="Вставьте ссылку..." MinHeight="52" CornerRadius="12" BorderBrush="{DynamicResource AppInputBorder}" BorderThickness="2" VerticalContentAlignment="Center" TextChanged="OnUrlTextChanged" Foreground="{DynamicResource AppTextPrimary}" Background="{DynamicResource AppInputBackground}">
                                <TextBox.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuItem Header="Вырезать" Click="UrlBox_Cut_Click"/>
                                        <MenuItem Header="Копировать" Click="UrlBox_Copy_Click"/>
                                        <MenuItem Header="Вставить" Click="UrlBox_Paste_Click"/>
                                        <MenuItem Header="Выделить всё" Click="UrlBox_SelectAll_Click"/>
                                    </MenuFlyout>
                                </TextBox.ContextFlyout>
                            </TextBox>
                            <Button x:Name="PasteButton" Grid.Column="1" Content="ВСТАВИТЬ" Click="OnPasteClick" Classes="mc-btn mc-btn-stone" FontSize="16" MinWidth="130" MinHeight="52" Margin="10,0,0,0"/>
                        </Grid>
                                                                        <Button x:Name="FindButton"
                                Content="ИСКАТЬ ВИДЕО"
                                Click="FetchInfo"
                                Classes="mc-btn mc-btn-youtube"
                                FontSize="22"
                                FontWeight="Bold"
                                HorizontalAlignment="Stretch"
                                MinHeight="56"
                                IsEnabled="False"/>


                        <StackPanel x:Name="InfoPanel" IsVisible="False" Spacing="16">
                            <Grid ColumnDefinitions="240, *" RowDefinitions="Auto">
                                <Border Grid.Column="0" CornerRadius="12" ClipToBounds="True" Height="135" Background="Black" BoxShadow="0 2 8 0 #20000000">
                                    <Grid>
                                        <!-- Картинка превью -->
                                        <Image x:Name="PreviewImage" Stretch="UniformToFill"/>
                                        
                                        <!-- Плашка со временем как на YouTube -->
                                        <Border x:Name="DurationBorder" 
                                                Background="#CC000000" 
                                                CornerRadius="4" 
                                                Padding="6,2" 
                                                HorizontalAlignment="Right" 
                                                VerticalAlignment="Bottom" 
                                                Margin="8">
                                            <TextBlock x:Name="VideoDuration" 
                                                       Foreground="White" 
                                                       FontSize="12" 
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="20,0,0,0" Spacing="5" VerticalAlignment="Center">
                                    <TextBlock x:Name="VideoTitle" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" MaxLines="3"/>
                                    <TextBlock x:Name="VideoDescription1" FontSize="15" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="3"/>
                                    <TextBlock x:Name="VideoAuthor" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondary}"/>
                                </StackPanel>
                            </Grid>

                            <Separator Height="1" Background="{DynamicResource AppDivider}"/>

                            <Label Content="Выберите тип скачивания:" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                            <ComboBox x:Name="DownloadTypeList" 
                                      MinHeight="52"
                                      VerticalContentAlignment="Center"
                                      HorizontalAlignment="Stretch"
                                      SelectedIndex="0" 
                                      SelectionChanged="DownloadTypeChanged">
                                <ComboBoxItem Content="Видео (MP4)"/>
                                <ComboBoxItem Content="Аудио (MP3)"/>
                            </ComboBox>

                            <Label x:Name="QualityOrBitrateLabel" Content="Выберите качество:" FontWeight="SemiBold" FontSize="17"/>
                            <ComboBox x:Name="QualityOrBitrateList" 
                                      MinHeight="52"
                                      VerticalContentAlignment="Center"
                                      HorizontalAlignment="Stretch" 
                                      SelectionChanged="OnQualityOrBitrateChanged"/>

                            <Label x:Name="AudioLabel" Content="Выберите звуковую дорожку:" FontWeight="SemiBold" FontSize="17" IsVisible="False"/>
                            <ComboBox x:Name="AudioList" MinHeight="52" HorizontalAlignment="Stretch" IsVisible="False"/>

                            <Separator Height="1" Background="{DynamicResource AppDivider}" Margin="0,10"/>
                        <Button x:Name="DownloadButton" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" 
                                Content="СКАЧАТЬ РЕСУРСЫ" 
                                Click="Download" 
                                Classes="mc-btn mc-btn-green"
                                FontSize="24"
                                FontWeight="Bold" 
                                Foreground="#55FF55" 
                                MinHeight="54" 
                                Padding="0,10"
                                HorizontalAlignment="Stretch" 
                                IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </ContentControl>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
