<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:drawable="@drawable/btn_mc_inactive" />
    <item>
        <ripple android:color="#E60000">
            <item>
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <solid android:color="#8B0000" />
                            <corners android:radius="?attr/appCornerRadius" />
                        </shape>
                    </item>
                    <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
                        <shape android:shape="rectangle">
                            <solid android:color="@color/mc_youtube_bg" />
                            <corners android:radius="?attr/appCornerRadius" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </ripple>
    </item>
</selector>