<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.MarsXZMedia" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mc_green_bg</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Default Style: Rounded -->
        <item name="appCornerRadius">12dp</item>
        <item name="isMinecraftStyle">false</item>

        <!-- Global Button Style -->
        <item name="materialButtonStyle">@style/Widget.MarsXZMedia.Button</item>

        <!-- Dark Theme: Light Icons (false) -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <!-- Square Minecraft Style -->
    <style name="Theme.MarsXZMedia.Square" parent="Base.Theme.MarsXZMedia">
        <item name="appCornerRadius">0dp</item>
        <item name="isMinecraftStyle">true</item>
    </style>

    <style name="Widget.MarsXZMedia.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">?attr/appCornerRadius</item>
    </style>
</resources>